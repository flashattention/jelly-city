# 비밀 값 (API 키, 비밀번호, 인증서) — 절대 커밋하지 않기
.env
.env.*
!.env.example
# 토스 로그인 mTLS 인증서 · 키 같은 것 (Fly 비밀 값으로만 넣는다)
*.pem
*.key
*.crt
*.p12
*.pfx

# 의존성
node_modules/

# 게임 세계 저장 데이터 (플레이어 계정, 친밀도, 대화 기억)
data/
*.tmp

# 로그
*.log
npm-debug.log*

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 배포 도구가 만드는 로컬 파일
.fly/
.render/

# 토스 미니앱: 번들 · SDK · 빌드한 .ait (toss/app 에서 npm run build 로 만든다)
toss/web/
toss/app/dist/
toss/app/node_modules/
toss/app/*.ait

# 마이크로소프트 스토어 패키지 (PWABuilder 로 만든다)
*.msix
*.msixbundle
*.appx
*.appxbundle
